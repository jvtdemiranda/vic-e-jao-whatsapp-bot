# --- Demo web (Vercel / npm run dev) ---
# Chave da Groq (https://console.groq.com/keys). Sem ela, o bot roda no modo offline.
GROQ_API_KEY=
# Opcional: troque o modelo se o padrão for descontinuado pela Groq.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Versão original (n8n + Evolution API + WhatsApp real) ---
EVOLUTION_API_KEY=sua_chave_aqui
